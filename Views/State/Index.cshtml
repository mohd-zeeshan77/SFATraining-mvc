@{
}

<div>
    <a>create</a>
    <Table>
        <thead>
            <tr>
                <th style="border: 1px solid black; padding: 8px;">Name</th>
                <th style="border: 1px solid black; padding: 8px;">Code</th>
            </tr>
        </thead>
        <tbody>
        @foreach(var name in Model)
        {
            <tr>
                    <td style="border: 1px solid black; padding: 8px;">@name.Name</td>
                    <td style="border: 1px solid black; padding: 8px;">@name.Code</td>
            </tr>
        }
        </tbody>
    </Table>
</div>
